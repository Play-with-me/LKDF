{
  "name": "@lkdf/desktop",
  "version": "0.1.0",
  "description": "Cửu Châu Ẩn Kiếm (Blades of the Nine Realms) — Chiến thuật thẻ bài võ hiệp 4–8 người",
  "author": "Blades of the Nine Realms Studio",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && electron .",
    "dev": "concurrently -k -n renderer,electron -c blue,yellow \"vite\" \"node scripts/wait-and-launch-electron.mjs\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "package:win:dir": "npm run build && electron-builder --config electron-builder.yml --win --dir --publish never",
    "package:win": "npm run build && electron-builder --config electron-builder.yml --win nsis --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@iconify/react": "^6.0.4",
    "@lkdf/shared": "*",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  }
}
