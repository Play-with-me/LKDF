# Cấu hình mẫu cho apps/server (KHÔNG ghi giá trị thật vào Git)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Google OAuth 2.0 (Thiết lập ở Giai đoạn 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
JWT_SESSION_SECRET=

# Kho lưu dữ liệu Cloud 0 đồng (Thiết lập ở Giai đoạn 2)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Cổng trung gian cập nhật 1-Click từ GitHub Private (Thiết lập ở Giai đoạn 5)
GITHUB_REPO=Play-with-me/LKDF
GITHUB_RELEASE_TOKEN=
